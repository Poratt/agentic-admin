# admin-agents

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Operating Systems
.DS_Store
Thumbs.db

# Angular local overrides
.component-store/

# Dependencies and Builds
node_modules/       
dist/               
.angular/           

# Environment variables
.env
.env.local
.env.*.local
.env.development
.env.production

# Local SearXNG dev instance (bind mount, contains generated secret_key)
searxng/
!docker/searxng/
!docker/searxng/settings.yml          

# Diagnostics and Testing
*.log
coverage/

# TypeScript Cache
*.tsbuildinfo

# Playwright MCP artifacts and logs
.playwright-mcp/
page-*
console-*

# Claude Code
.claude/plans/
.claude/memory/
.claude/*.local.json
.CLAUDE/settings.local.json
*.local.json

# Nx (אם אתה משתמש ב-Nx)
.nx/cache/
.nx/workspace-data/

# Angular / NestJS נוספים
.angular/
dist/
coverage/
*.tsbuildinfo

# Logs and temp
*.log
.tmp/
temp/.codex/

# Graphify cache
graphify-out/

# PrimeNG license key (contains secret)
frontend/src/app/environments/environment.ts
frontend/src/app/environments/environment.prod.ts
# DB dumps and backups (may contain plaintext secrets)
backup_*.sql
*.sql.bak

# Freebuff local tool state
.freebuff/

# WorkBuddy AI local agent state (project memory + project-level skills).
# Same category as .freebuff/ above: local tool state, not source. The daily
# logs churn every session, so tracking them would add noise to every diff.
# Un-ignore a specific path with a negation rule if the team should share it.
.workbuddy-ai/
